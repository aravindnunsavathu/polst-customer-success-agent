POSTGRES_DB=polst_cs
POSTGRES_USER=polst_app
POSTGRES_PASSWORD=localdev
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://polst_app:localdev@localhost:5433/polst_cs

# Separate database for pytest — tests/conftest.py's db_session fixture
# truncates everything before each test, so this must never point at the
# same database as DATABASE_URL above or a test run wipes your seeded
# demo data. docker/init-test-db.sql creates this automatically on a
# fresh `docker compose up`.
TEST_DATABASE_URL=postgresql+psycopg://polst_app:localdev@localhost:5433/polst_cs_test
