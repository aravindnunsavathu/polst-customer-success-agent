# Copy to terraform.tfvars and adjust. Nothing here is a secret — the DB
# password is generated by Terraform and stored in Secrets Manager, never
# written to a .tfvars file.

aws_region   = "us-east-1"
project_name = "polst-cs"
environment  = "staging"

# Must match the GitHub repo that's allowed to assume the deploy role.
github_repository = "aravindnunsavathu/polst-customer-success-agent"

# Leave container_image unset on the first apply — it defaults to a
# placeholder. CI updates the running task definition directly afterward.
